{
  "name": "java4br",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.22.2"
  },
  "scripts": {
    "generate:content": "node scripts/generate-course-content.mjs",
    "inventory:update": "node scripts/update-source-inventory.mjs --accept-content-changes",
    "dev": "vite",
    "build": "tsc -b && vite build && node scripts/generate-service-worker.mjs",
    "typecheck": "tsc -b --pretty false",
    "lint": "eslint platform/src vite.config.mts vitest.config.mts",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "validate:links": "node scripts/validate-links.mjs",
    "audit:master": "node scripts/audit-master-course.mjs",
    "validate:fidelity": "node scripts/validate-content-fidelity.mjs",
    "validate:english": "node scripts/validate-english.mjs",
    "validate:technical-english": "node scripts/validate-technical-english-contract.mjs",
    "validate:pedagogy": "node validate-pedagogy.js",
    "validate:depth": "npm run audit:master && node scripts/validate-pedagogical-depth.mjs",
    "validate:platform": "node validate-platform.mjs",
    "validate:ui": "node scripts/validate-ui-accessibility-contract.mjs",
    "validate:learning-tools": "node scripts/validate-learning-tools-contract.mjs",
    "validate:catalog": "node scripts/validate-catalog-integrity.mjs",
    "validate:assessment": "node scripts/validate-assessment-integrity.mjs",
    "validate:resources": "node scripts/validate-resource-integrity.mjs",
    "validate:progress": "node scripts/validate-progress-contract.mjs",
    "validate:deployment": "node scripts/validate-deployment-readiness.mjs",
    "validate:final-release": "node scripts/validate-final-release.mjs",
    "validate:traceability": "node scripts/validate-traceability-contract.mjs",
    "validate:master-spec": "node scripts/validate-master-spec-closure.mjs",
    "validate:maintenance": "node scripts/validate-maintenance-guardrails.mjs",
    "validate": "npm run generate:content && npm run validate:fidelity && npm run validate:english && npm run validate:technical-english && npm run validate:depth && npm run typecheck && npm run lint && npm run test && npm run build && npm run validate:pedagogy && npm run validate:platform && npm run validate:ui && npm run validate:learning-tools && npm run validate:catalog && npm run validate:assessment && npm run validate:resources && npm run validate:progress && npm run validate:deployment && npm run validate:final-release && npm run validate:traceability && npm run validate:master-spec && npm run validate:maintenance && npm run test:e2e"
  },
  "dependencies": {
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/vite": "4.3.3",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.2",
    "@types/node": "24.10.1",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@vitejs/plugin-react": "6.1.0",
    "axe-core": "4.13.0",
    "eslint": "10.8.1",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.4",
    "fake-indexeddb": "6.2.4",
    "globals": "16.5.0",
    "jsdom": "30.0.1",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "typescript-eslint": "8.67.0",
    "vite": "8.2.2",
    "vitest": "4.1.11"
  }
}
