{
  "name": "java4br",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.22.2"
  },
  "scripts": {
    "generate:content": "node scripts/generate-course-content.mjs",
    "dev": "vite",
    "build": "tsc -b && vite build && node scripts/generate-service-worker.mjs",
    "typecheck": "tsc -b --pretty false",
    "lint": "eslint platform/src vite.config.mts vitest.config.mts",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "validate:links": "node scripts/validate-links.mjs",
    "validate:fidelity": "node scripts/validate-content-fidelity.mjs",
    "validate:english": "node scripts/validate-english.mjs",
    "validate:pedagogy": "node validate-pedagogy.js",
    "validate:platform": "node validate-platform.mjs",
    "validate": "npm run generate:content && npm run validate:fidelity && npm run validate:english && npm run typecheck && npm run lint && npm run test && npm run build && npm run validate:pedagogy && npm run validate:platform && npm run test:e2e"
  },
  "dependencies": {
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/vite": "4.3.3",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.2",
    "@types/node": "24.10.1",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@vitejs/plugin-react": "6.1.0",
    "axe-core": "4.13.0",
    "eslint": "10.8.1",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.4",
    "fake-indexeddb": "6.2.4",
    "globals": "16.5.0",
    "jsdom": "30.0.1",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "typescript-eslint": "8.67.0",
    "vite": "8.2.2",
    "vitest": "4.1.11"
  }
}
